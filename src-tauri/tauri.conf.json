{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Achluophobia",
  "version": "1.0.0",
  "identifier": "kr.nee.achluophobia",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "아클루오포비아",
        "url": "https://nee.n-e.kr/school/client/",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 450,
        "center": true,
        "resizable": true,
        "fullscreen": true,
        "backgroundColor": "#05070b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["Korean", "English"], "displayLanguageSelector": false }
    }
  }
}
